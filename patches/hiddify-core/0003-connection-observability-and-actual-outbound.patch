@@ -0,0 +1,43 @@
+package trafficontrol
+
+import (
+	"encoding/json"
+	"sync/atomic"
+	"testing"
+
+	"github.com/gofrs/uuid/v5"
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+)
+
+func TestMarshalJSONExposesRealBalancerOutbound(t *testing.T) {
+	metadata := adapter.InboundContext{}
+	metadata.SetRealOutbound("nimbus-proxy")
+	tracker := TrackerMetadata{
+		ID:           uuid.Nil,
+		Metadata:     metadata,
+		Upload:       new(atomic.Int64),
+		Download:     new(atomic.Int64),
+		Chain:        []string{"balance", "select"},
+		Outbound:     "balance",
+		OutboundType: C.TypeBalancer,
+	}
+
+	raw, err := tracker.MarshalJSON()
+	if err != nil {
+		t.Fatalf("marshal tracker: %v", err)
+	}
+	var payload struct {
+		Chains   []string `json:"chains"`
+		Outbound string   `json:"outbound"`
+	}
+	if err := json.Unmarshal(raw, &payload); err != nil {
+		t.Fatalf("decode tracker: %v", err)
+	}
+	if payload.Outbound != "nimbus-proxy" {
+		t.Fatalf("expected real outbound, got %q", payload.Outbound)
+	}
+	if len(payload.Chains) != 3 || payload.Chains[0] != "nimbus-proxy" {
+		t.Fatalf("expected real outbound at the head of chains, got %v", payload.Chains)
+	}
+}
