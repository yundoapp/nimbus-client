+// LastUpdated reports when the currently active rule-set snapshot was loaded.
+// It is observability only; update scheduling and remote loading remain in
+// the existing rule-set lifecycle.
+func (s *RemoteRuleSet) LastUpdated() time.Time {
+	s.access.RLock()
+	defer s.access.RUnlock()
+	return s.lastLoaded
+}
+
+func (s *RemoteRuleSet) setLastUpdated(updatedAt time.Time) {
+	s.access.Lock()
+	s.lastUpdated = updatedAt
+	s.access.Unlock()
+}
+
+func (s *RemoteRuleSet) setLastLoaded(loadedAt time.Time) {
+	s.access.Lock()
+	s.lastLoaded = loadedAt
+	s.access.Unlock()
+}
