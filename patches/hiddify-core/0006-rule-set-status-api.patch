-func getRuleProviders(w http.ResponseWriter, r *http.Request) {
+func getRuleProviders(w http.ResponseWriter, r *http.Request, router adapter.Router) {
+	providers := make([]ruleProviderStatus, 0)
+	if lister, ok := router.(ruleSetLister); ok {
+		for _, ruleSet := range lister.RuleSets() {
+			provider := ruleProviderStatus{Name: ruleSet.Name()}
+			if timestamp, ok := ruleSet.(ruleSetTimestamp); ok {
