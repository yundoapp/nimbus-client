 func (s *RemoteRuleSet) Match(metadata *adapter.InboundContext) bool {
+	if s.matchRules(metadata) {
+		return true
+	}
+
+	// Some geosite sources store a registrable domain as an exact domain.
+	// Retry explicit root and parent-domain entries after the normal match
+	// fails; this never invents a rule or changes an unlisted domain.
+	host := metadata.Domain
+	if host == "" {
+		host = metadata.Destination.Fqdn
+	}
+	host = strings.TrimSuffix(strings.ToLower(host), ".")
+	root, err := publicsuffix.EffectiveTLDPlusOne(host)
+	if err != nil || root == "" || root == host {
+		return false
+	}
+
+	originalDomain := metadata.Domain
+	defer func() { metadata.Domain = originalDomain }()
+	publicSuffix, _ := publicsuffix.PublicSuffix(host)
+	candidate := host
+	for {
+		separator := strings.IndexByte(candidate, '.')
+		if separator < 0 {
+			break
+		}
+		candidate = candidate[separator+1:]
+		if candidate == "" || candidate == publicSuffix {
+			break
+		}
+		metadata.Domain = candidate
+		if s.matchRules(metadata) {
+			return true
+		}
+		if candidate == root {
+			break
+		}
+	}
+	return false
+}
+
+func (s *RemoteRuleSet) matchRules(metadata *adapter.InboundContext) bool {
 	for _, rule := range s.rules {
 		if rule.Match(metadata) {
 			return true
 		}
 	}
 	return false
 }
