+func TestRouteDecisionForTerminalOutboundType(t *testing.T) {
+	tests := map[string]string{
+		C.TypeDirect:   routeDecisionDirect,
+		C.TypeBlock:    routeDecisionRejected,
+		"socks":        routeDecisionAccelerated,
+		C.TypeDNS:      "",
+		C.TypeSelector: "",
+		C.TypeURLTest:  "",
+		C.TypeBalancer: "",
+	}
+	for outboundType, expected := range tests {
+		if actual := routeDecisionForOutboundType(outboundType); actual != expected {
+			t.Fatalf("type %q: expected %q, got %q", outboundType, expected, actual)
+		}
+	}
 }
