@@ -0,0 +1,50 @@
+package clashapi
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/experimental/clashapi/trafficontrol"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func TestExactRouteHistoryQueryIsOptIn(t *testing.T) {
+	manager := trafficontrol.NewManager()
+	manager.RecordRejected(adapter.InboundContext{
+		Network:     "tcp",
+		Domain:      "blocked.example",
+		Destination: M.ParseSocksaddr("blocked.example:443"),
+	}, nil)
+	handler := getConnections(manager)
+
+	nativeRecorder := httptest.NewRecorder()
+	handler(nativeRecorder, httptest.NewRequest("GET", "/connections", nil))
+	if nativeRecorder.Code != 200 {
+		t.Fatalf("native endpoint returned %d", nativeRecorder.Code)
+	}
+	if countConnections(t, nativeRecorder.Body.Bytes()) != 0 {
+		t.Fatal("native endpoint must remain active-only")
+	}
+
+	exactRecorder := httptest.NewRecorder()
+	handler(exactRecorder, httptest.NewRequest("GET", "/connections?yundo_exact_history=1", nil))
+	if exactRecorder.Code != 200 {
+		t.Fatalf("exact endpoint returned %d", exactRecorder.Code)
+	}
+	if countConnections(t, exactRecorder.Body.Bytes()) != 1 {
+		t.Fatal("exact endpoint must include the rejected request")
+	}
+}
+
+func countConnections(t *testing.T, raw []byte) int {
+	t.Helper()
+	var payload struct {
+		Connections []json.RawMessage `json:"connections"`
+	}
+	if err := json.Unmarshal(raw, &payload); err != nil {
+		t.Fatalf("decode connections response: %v", err)
+	}
+	return len(payload.Connections)
+}
