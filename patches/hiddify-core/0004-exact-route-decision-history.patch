+package trafficontrol
+
+import (
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func TestExactHistoryIncludesRejectedRequestsWithoutChangingNativeSnapshot(t *testing.T) {
+	manager := NewManager()
+	manager.RecordRejected(adapter.InboundContext{
+		Network:     "tcp",
+		Domain:      "blocked.example",
+		Destination: M.ParseSocksaddr("blocked.example:443"),
+	}, nil)
+
+	if len(manager.Snapshot().Connections) != 0 {
+		t.Fatal("native active snapshot must remain unchanged")
+	}
+	exact := manager.ExactHistorySnapshot()
+	if len(exact.Connections) != 1 {
+		t.Fatalf("expected one rejected history record, got %d", len(exact.Connections))
+	}
+	if exact.Connections[0].ExactDecision() != routeDecisionRejected {
+		t.Fatalf("expected rejected decision, got %q", exact.Connections[0].ExactDecision())
+	}
+	if exact.Connections[0].ClosedAt.IsZero() {
+		t.Fatal("rejected request must be completed immediately")
+	}
+}
