+			outboundType = resolvedOutbound.Type()
+			_, isGroup := resolvedOutbound.(adapter.OutboundGroup)
+			terminalOutbound = !isGroup
+		}
+	}
+	decision = t.Decision
+	if decision == "" && terminalOutbound {
+		decision = routeDecisionForOutboundType(outboundType)
+	}
+	return
+}
