@@ -0,0 +1,75 @@
+package config
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+)
+
+func TestManagedRoutesAreAddedWithoutReplacingHiddifyRouting(t *testing.T) {
+	settings := DefaultHiddifyOptions()
+	err := json.Unmarshal([]byte(`{
+		"managed-route-rules": [{
+			"domain_suffix": ["rawya.ai"],
+			"action": "route",
+			"outbound": "direct §hide§"
+		}],
+		"managed-route-rule-sets": [{
+			"type": "remote",
+			"tag": "geosite-test",
+			"format": "binary",
+			"url": "https://rules.example/geosite-test.srs",
+			"download_detour": "nimbus-proxy",
+			"update_interval": "24h"
+		}]
+	}`), settings)
+	if err != nil {
+		t.Fatalf("unmarshal managed routes: %v", err)
+	}
+
+	options := option.Options{DNS: &option.DNSOptions{}}
+	if err := setRoutingOptions(&options, settings); err != nil {
+		t.Fatalf("build routing options: %v", err)
+	}
+
+	routeJSON, err := json.Marshal(options.Route)
+	if err != nil {
+		t.Fatalf("marshal route options: %v", err)
+	}
+	var route map[string]any
+	if err := json.Unmarshal(routeJSON, &route); err != nil {
+		t.Fatalf("decode route options: %v", err)
+	}
+
+	rules, ok := route["rules"].([]any)
+	if !ok || len(rules) < 3 {
+		t.Fatalf("expected Hiddify setup rules and managed rule, got %v", route["rules"])
+	}
+	foundManagedRule := false
+	foundSniffRule := false
+	for _, rawRule := range rules {
+		rule, _ := rawRule.(map[string]any)
+		if rule["action"] == "sniff" {
+			foundSniffRule = true
+		}
+		if suffix, ok := rule["domain_suffix"].(string); ok && suffix == "rawya.ai" {
+			foundManagedRule = rule["outbound"] == "direct §hide§"
+		}
+	}
+	if !foundSniffRule {
+		t.Fatal("Hiddify sniff rule was replaced")
+	}
+	if !foundManagedRule {
+		t.Fatalf("managed rawya.ai direct rule was not added: %s", routeJSON)
+	}
+
+	ruleSets, ok := route["rule_set"].([]any)
+	if !ok || len(ruleSets) != 1 {
+		t.Fatalf("expected one managed rule set, got %v", route["rule_set"])
+	}
+	ruleSet, _ := ruleSets[0].(map[string]any)
+	if ruleSet["tag"] != "geosite-test" || ruleSet["download_detour"] != "nimbus-proxy" {
+		t.Fatalf("unexpected managed rule set: %v", ruleSet)
+	}
+}
