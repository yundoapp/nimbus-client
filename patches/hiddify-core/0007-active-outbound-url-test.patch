+// resolveSelectedOutboundTag follows nested selector/balancer selections to
+// the concrete outbound whose URLTest result is authoritative. It is read-only
+// and deliberately bounded by cycle detection because malformed configurations
+// must never make proxy-info streaming loop forever.
+func (h *HiddifyInstance) resolveSelectedOutboundTag(tag string) string {
+	box := h.Box()
+	if box == nil {
+		return tag
+	}
+
+	visited := make(map[string]struct{})
+	for {
+		if _, seen := visited[tag]; seen {
+			return tag
+		}
+		visited[tag] = struct{}{}
+
+		outbound, loaded := box.Outbound().Outbound(tag)
+		if !loaded {
+			return tag
+		}
+		group, isGroup := outbound.(adapter.OutboundGroup)
+		if !isGroup {
+			return tag
+		}
+		next := group.Now()
+		if next == "" {
+			// A single-member balancer such as the connection plan's default
+			// balance group has no stable Now() value under round-robin. It is
+			// still unambiguous which concrete outbound supplies its URLTest
+			// result, so follow that only-member edge.
+			members := group.All()
+			if len(members) == 1 && members[0] != tag {
+				next = members[0]
+			} else {
+				return tag
+			}
+		}
+		if next == tag {
+			return tag
+		}
+		tag = next
+	}
+}
